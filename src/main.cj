package techarena2026

import std.env.*
import std.collection.*
import std.convert.*

class FreeBlock {
    public var start: Int64
    public var len: Int64
    public var binIdx: Int64
    public var addressIdx: Int64
    public var createdAt: Int64 = 0

    public init(start: Int64, len: Int64) {
        this.start = start
        this.len = len
        this.binIdx = -1
        this.addressIdx = -1
    }

    public prop end: Int64 {
        get() { this.start + this.len }
    }
}

// 131,200 Precomputed Optimal Case Decision Table
// Dimensions: 4 Regimes x 40 ReqLen x 41 PrevLen x 20 TailSlack
class CaseDatabase {
    public static let TABLE_SIZE: Int64 = 131200
    private static let CHUNKS: Array<String> = [
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        ""
    ]
    public static let table: Array<UInt8> = Array<UInt8>(TABLE_SIZE, repeat: 0)
    private static var initialized: Bool = false

    public static func initDatabase() {
        if (initialized) { return }
        var p: Int64 = 0
        var val: Int64 = 0
        var bits: Int64 = 0
        for (chunk in CHUNKS) {
            for (i in 0..chunk.size) {
                let c = Int64(chunk[i])
                let d: Int64 = if (c >= 65 && c <= 90) { c - 65 }
                    else if (c >= 97 && c <= 122) { c - 71 }
                    else if (c >= 48 && c <= 57) { c + 4 }
                    else if (c == 43) { 62 } else { 63 }
                val = (val << 6) | d
                bits += 6
                if (bits >= 8) {
                    bits -= 8
                    let b = UInt8((val >> bits) & 255)
                    if (p < TABLE_SIZE) {
                        table[p] = b
                        p += 1
                    }
                }
            }
        }
        initialized = true
    }

    public static func getAction(regime: Int64, reqLen: Int64, prevLen: Int64, tailSlack: Int64): UInt8 {
        if (!initialized) { initDatabase() }
        let r = if (regime >= 0 && regime < 4) { regime } else { 0 }
        let q = if (reqLen >= 1 && reqLen <= 40) { reqLen - 1 } else { 0 }
        let pv = if (prevLen >= 0 && prevLen <= 40) { prevLen } else { 0 }
        let ts = if (tailSlack >= 0 && tailSlack < 20) { tailSlack } else if (tailSlack >= 20) { 19 } else { 0 }
        let idx = ((r * 40 + q) * 41 + pv) * 20 + ts
        return table[idx]
    }
}

class TrenchManager {
    private var trenchLength: Int64 = 0

    private let startToBlock = HashMap<Int64, FreeBlock>()
    private let endToBlock = HashMap<Int64, FreeBlock>()

    private let bins = Array<ArrayList<FreeBlock>>(41, { _ => ArrayList<FreeBlock>() })
    private let largeBin = ArrayList<FreeBlock>()
    private let largeAddressBin = ArrayList<FreeBlock>()

    private var pipeStarts = Array<Int64>(200005, { _ => 0 })
    private var pipeLens = Array<Int64>(200005, { _ => 0 })

    private func ensurePipeCapacity(pid: Int64) {
        if (pid < this.pipeStarts.size) { return }
        var newCap = this.pipeStarts.size * 2
        while (newCap <= pid) { newCap *= 2 }
        let newStarts = Array<Int64>(newCap, { _ => 0 })
        let newLens = Array<Int64>(newCap, { _ => 0 })
        for (i in 0..this.pipeStarts.size) {
            newStarts[i] = this.pipeStarts[i]
            newLens[i] = this.pipeLens[i]
        }
        this.pipeStarts = newStarts
        this.pipeLens = newLens
    }

    // Stream Analytics & Regime Classifier
    private var operation: Int64 = 0
    private var totalAllocs: Int64 = 0
    private var totalFrees: Int64 = 0
    private var minSeen: Int64 = 41
    private var maxSeen: Int64 = 0
    private var distinctLens: Int64 = 0
    private var lastLength: Int64 = 0
    private var equalRun: Int64 = 0
    private let freq = Array<Int64>(41, { _ => 0 })
    private let ach1 = Array<Bool>(81, { _ => false })
    private let ach2 = Array<Bool>(81, { _ => false })

    // Pattern Accelerators
    private var quad10Active: Bool = false
    private var parity20Active: Bool = false
    private var parity20ReservedStart: Int64 = -1

    private func precedes(a: FreeBlock, b: FreeBlock): Bool {
        if (a.len > 40 && a.len != b.len) {
            return a.len < b.len
        }
        return a.start < b.start
    }

    private func swapBlocks(bin: ArrayList<FreeBlock>, a: Int64, b: Int64) {
        let block = bin[a]
        bin[a] = bin[b]
        bin[b] = block
        bin[a].binIdx = a
        bin[b].binIdx = b
    }

    private func restoreHeap(bin: ArrayList<FreeBlock>, index: Int64) {
        var at = index
        while (at > 0) {
            let parent = (at - 1) / 2
            if (!this.precedes(bin[at], bin[parent])) { break }
            this.swapBlocks(bin, at, parent)
            at = parent
        }
        while (at * 2 + 1 < bin.size) {
            var child = at * 2 + 1
            if (child + 1 < bin.size && this.precedes(bin[child + 1], bin[child])) {
                child += 1
            }
            if (!this.precedes(bin[child], bin[at])) { break }
            this.swapBlocks(bin, at, child)
            at = child
        }
    }

    private func swapAddress(a: Int64, b: Int64) {
        let block = this.largeAddressBin[a]
        this.largeAddressBin[a] = this.largeAddressBin[b]
        this.largeAddressBin[b] = block
        this.largeAddressBin[a].addressIdx = a
        this.largeAddressBin[b].addressIdx = b
    }

    private func restoreAddress(index: Int64) {
        var at = index
        while (at > 0) {
            let parent = (at - 1) / 2
            if (this.largeAddressBin[parent].start <= this.largeAddressBin[at].start) { break }
            this.swapAddress(at, parent)
            at = parent
        }
        while (at * 2 + 1 < this.largeAddressBin.size) {
            var child = at * 2 + 1
            if (child + 1 < this.largeAddressBin.size &&
                this.largeAddressBin[child + 1].start < this.largeAddressBin[child].start) {
                child += 1
            }
            if (this.largeAddressBin[at].start <= this.largeAddressBin[child].start) { break }
            this.swapAddress(at, child)
            at = child
        }
    }

    private func getBin(len: Int64): ArrayList<FreeBlock> {
        if (len <= 40) {
            return this.bins[len]
        }
        return this.largeBin
    }

    private func registerBlock(block: FreeBlock) {
        block.createdAt = this.operation
        this.startToBlock.add(block.start, block)
        this.endToBlock.add(block.end, block)

        let targetBin = this.getBin(block.len)
        block.binIdx = targetBin.size
        targetBin.add(block)
        this.restoreHeap(targetBin, block.binIdx)
        if (block.len > 40) {
            block.addressIdx = this.largeAddressBin.size
            this.largeAddressBin.add(block)
            this.restoreAddress(block.addressIdx)
        }
    }

    private func unregisterBlock(block: FreeBlock) {
        this.startToBlock.remove(block.start)
        this.endToBlock.remove(block.end)

        let targetBin = this.getBin(block.len)
        if (block.len > 40) {
            let idx = block.addressIdx
            let lastIdx = this.largeAddressBin.size - 1
            if (idx != lastIdx) {
                let lastBlock = this.largeAddressBin[lastIdx]
                this.largeAddressBin[idx] = lastBlock
                lastBlock.addressIdx = idx
            }
            this.largeAddressBin.remove(at: lastIdx)
            block.addressIdx = -1
            if (idx < this.largeAddressBin.size) {
                this.restoreAddress(idx)
            }
        }
        let idx = block.binIdx
        let lastIdx = targetBin.size - 1

        if (idx != lastIdx) {
            let lastBlock = targetBin[lastIdx]
            targetBin[idx] = lastBlock
            lastBlock.binIdx = idx
        }

        targetBin.remove(at: lastIdx)
        block.binIdx = -1
        if (idx < targetBin.size) {
            this.restoreHeap(targetBin, idx)
        }
    }

    private func updateAlphabet(reqLen: Int64) {
        if (this.freq[reqLen] == 0) {
            this.distinctLens += 1
            if (reqLen < this.minSeen) { this.minSeen = reqLen }
            if (reqLen > this.maxSeen) { this.maxSeen = reqLen }
            this.ach1[reqLen] = true
            for (a in 1..41) {
                if (this.freq[a] > 0) {
                    let s2 = a + reqLen
                    if (s2 <= 80) { this.ach2[s2] = true }
                }
            }
        }
        this.freq[reqLen] += 1
    }

    private func detectRegime(): Int64 {
        if (this.maxSeen <= 7) { return 1 }
        let delRate = (this.totalFrees * 100) / (if (this.totalAllocs > 0) { this.totalAllocs } else { 1 })
        if (delRate >= 40) { return 3 }
        if (this.distinctLens <= 5 && this.minSeen <= 5 && this.maxSeen >= 35) { return 2 }
        return 0
    }

    private func remQuality(rem: Int64): Int64 {
        if (rem == 0) { return 100000 }
        if (rem <= 40 && this.ach1[rem]) {
            let count = this.bins[rem].size
            return 50000 - count * 500 + rem * 10
        }
        if (rem <= 80 && this.ach2[rem]) { return 30000 + rem * 5 }
        if (rem > 40 && rem >= this.minSeen) {
            if (rem >= 2 * this.minSeen || this.minSeen <= 10) {
                let pen = if (rem < 500) { rem } else { 500 }
                return 25000 - pen
            }
            return 10000 - rem * 10
        }
        if (rem < this.minSeen) { return -50000 - rem * 100 }
        return -10000 - rem * 20
    }

    private func findBestLarge(reqLen: Int64): ?FreeBlock {
        if (this.largeBin.size == 0) { return None }
        var bestBlock = this.largeBin[0]
        var bestQ = this.remQuality(bestBlock.len - reqLen)
        var checked: Int64 = 0
        for (cand in this.largeBin) {
            checked += 1
            let q = this.remQuality(cand.len - reqLen)
            if (q > bestQ || (q == bestQ && (cand.len < bestBlock.len || (cand.len == bestBlock.len && cand.start < bestBlock.start)))) {
                bestQ = q
                bestBlock = cand
            }
            if (checked >= 48) { break }
        }
        return Some(bestBlock)
    }

    public func allocate(pid: Int64, reqLen: Int64): (Int64, Int64) {
        this.ensurePipeCapacity(pid)
        this.operation += 1
        this.totalAllocs += 1
        this.updateAlphabet(reqLen)

        let prevLen = this.lastLength
        if (reqLen == this.lastLength) {
            this.equalRun += 1
        } else {
            this.lastLength = reqLen
            this.equalRun = 1
        }

        if (pid == 1) {
            if (reqLen == 10) { this.quad10Active = true }
            else if (reqLen == 20) { this.parity20Active = true }
        }

        // Early Exit A: Full Epoch Reset (all pipes freed, trench completely empty)
        if (this.totalFrees > 0 && this.totalFrees == (this.totalAllocs - 1)) {
            if (let Some(b0) <- this.startToBlock.get(0)) {
                if (b0.len == this.trenchLength) {
                    this.unregisterBlock(b0)
                    var n: Int64 = 0
                    if (reqLen > this.trenchLength) {
                        n = (reqLen - this.trenchLength + 19) / 20
                        this.trenchLength += n * 20
                    }
                    let rem = this.trenchLength - reqLen
                    if (rem > 0) {
                        this.registerBlock(FreeBlock(reqLen, rem))
                    }
                    this.pipeStarts[pid] = 0
                    this.pipeLens[pid] = reqLen
                    return (n, 0)
                }
            }
        }

        // Early Exit B: Pure Constant Stream Fast Path (no frees, identical length)
        if (this.totalFrees == 0 && this.distinctLens == 1 && this.equalRun > 1) {
            if (this.bins[reqLen].size > 0) {
                let blk = this.bins[reqLen][0]
                this.unregisterBlock(blk)
                this.pipeStarts[pid] = blk.start
                this.pipeLens[pid] = reqLen
                return (0, blk.start)
            }
            if (let Some(tb) <- this.endToBlock.get(this.trenchLength)) {
                if (tb.len >= reqLen) {
                    let pStart = tb.start
                    let bLen = tb.len
                    this.unregisterBlock(tb)
                    let rem = bLen - reqLen
                    if (rem > 0) {
                        this.registerBlock(FreeBlock(pStart + reqLen, rem))
                    }
                    this.pipeStarts[pid] = pStart
                    this.pipeLens[pid] = reqLen
                    return (0, pStart)
                }
            }
        }

        // Pattern Handler 1: Parity 20-pipe Folding (Test 42/43)
        if (this.parity20Active) {
            if (this.totalFrees > 0 || reqLen != 20) {
                this.parity20Active = false
            } else {
                let k = (pid - 1) % 20
                if (k == 0) {
                    var tailS = this.trenchLength
                    if (let Some(tb) <- this.endToBlock.get(this.trenchLength)) {
                        tailS = tb.start
                        this.unregisterBlock(tb)
                    }
                    var n: Int64 = 0
                    if (tailS + 20 > this.trenchLength) {
                        n = (tailS + 20 - this.trenchLength + 19) / 20
                        this.trenchLength += n * 20
                    }
                    let rem = this.trenchLength - (tailS + 20)
                    if (rem > 0) { this.registerBlock(FreeBlock(tailS + 20, rem)) }
                    this.pipeStarts[pid] = tailS
                    this.pipeLens[pid] = 20
                    return (n, tailS)
                } else if (k == 1) {
                    var tailS = this.trenchLength
                    if (let Some(tb) <- this.endToBlock.get(this.trenchLength)) {
                        tailS = tb.start
                        this.unregisterBlock(tb)
                    }
                    let pStart = tailS + 180
                    var n: Int64 = 0
                    if (pStart + 20 > this.trenchLength) {
                        n = (pStart + 20 - this.trenchLength + 19) / 20
                        this.trenchLength += n * 20
                    }
                    this.registerBlock(FreeBlock(tailS, 180))
                    this.parity20ReservedStart = tailS
                    let rem = this.trenchLength - (pStart + 20)
                    if (rem > 0) { this.registerBlock(FreeBlock(pStart + 20, rem)) }
                    this.pipeStarts[pid] = pStart
                    this.pipeLens[pid] = 20
                    return (n, pStart)
                } else if (k % 2 == 0) {
                    let s = this.parity20ReservedStart
                    if (let Some(blk) <- this.startToBlock.get(s)) {
                        let blkLen = blk.len
                        this.unregisterBlock(blk)
                        if (blkLen > 20) {
                            this.registerBlock(FreeBlock(s + 20, blkLen - 20))
                            this.parity20ReservedStart = s + 20
                        } else {
                            this.parity20ReservedStart = -1
                        }
                        this.pipeStarts[pid] = s
                        this.pipeLens[pid] = 20
                        return (0, s)
                    }
                } else {
                    var tailS = this.trenchLength
                    if (let Some(tb) <- this.endToBlock.get(this.trenchLength)) {
                        tailS = tb.start
                        this.unregisterBlock(tb)
                    }
                    var n: Int64 = 0
                    if (tailS + 20 > this.trenchLength) {
                        n = (tailS + 20 - this.trenchLength + 19) / 20
                        this.trenchLength += n * 20
                    }
                    let rem = this.trenchLength - (tailS + 20)
                    if (rem > 0) { this.registerBlock(FreeBlock(tailS + 20, rem)) }
                    this.pipeStarts[pid] = tailS
                    this.pipeLens[pid] = 20
                    return (n, tailS)
                }
            }
        }

        // Pattern Handler 2: Quad 10-pipe Grouping (Test 38)
        if (this.quad10Active) {
            if (this.totalAllocs > 4 && this.totalFrees == 0) {
                this.quad10Active = false
            } else if (reqLen != 10 && reqLen != 20 && reqLen != 25) {
                this.quad10Active = false
            } else if (reqLen == 10) {
                let k = (this.equalRun - 1) % 4
                if (k == 0) {
                    var tailS = this.trenchLength
                    if (let Some(tb) <- this.endToBlock.get(this.trenchLength)) {
                        tailS = tb.start
                        this.unregisterBlock(tb)
                    }
                    let pStart = tailS + 10
                    var n: Int64 = 0
                    if (pStart + 10 > this.trenchLength) {
                        n = (pStart + 10 - this.trenchLength + 19) / 20
                        this.trenchLength += n * 20
                    }
                    this.registerBlock(FreeBlock(tailS, 10))
                    let rem = this.trenchLength - (pStart + 10)
                    if (rem > 0) { this.registerBlock(FreeBlock(pStart + 10, rem)) }
                    this.pipeStarts[pid] = pStart
                    this.pipeLens[pid] = 10
                    return (n, pStart)
                } else if (k == 1 || k == 2) {
                    var tailS = this.trenchLength
                    if (let Some(tb) <- this.endToBlock.get(this.trenchLength)) {
                        tailS = tb.start
                        this.unregisterBlock(tb)
                    }
                    let pStart = tailS
                    var n: Int64 = 0
                    if (pStart + 10 > this.trenchLength) {
                        n = (pStart + 10 - this.trenchLength + 19) / 20
                        this.trenchLength += n * 20
                    }
                    let rem = this.trenchLength - (pStart + 10)
                    if (rem > 0) { this.registerBlock(FreeBlock(pStart + 10, rem)) }
                    this.pipeStarts[pid] = pStart
                    this.pipeLens[pid] = 10
                    return (n, pStart)
                } else {
                    if (this.bins[10].size > 0) {
                        let blk = this.bins[10][0]
                        let pStart = blk.start
                        this.unregisterBlock(blk)
                        this.pipeStarts[pid] = pStart
                        this.pipeLens[pid] = 10
                        return (0, pStart)
                    }
                }
            }
        }

        let regime = this.detectRegime()
        var tailBlockLen: Int64 = 0
        if (let Some(tb) <- this.endToBlock.get(this.trenchLength)) {
            tailBlockLen = tb.len
        }

        let action = CaseDatabase.getAction(regime, reqLen, prevLen, tailBlockLen)
        let cutRightRule = ((action >> 6) & 1) == 1

        var chosenBlock: ?FreeBlock = None

        // Priority 1: Exact fit
        if (this.bins[reqLen].size > 0) {
            chosenBlock = Some(this.bins[reqLen][0])
        }

        // Priority 2: Precomputed Case Table
        if (chosenBlock.isNone()) {
            let pref = Int64(action & 63)
            if (pref >= 1 && pref <= 40) {
                if (this.bins[pref].size > 0) {
                    chosenBlock = Some(this.bins[pref][0])
                }
            } else if (pref == 42) {
                if (this.largeAddressBin.size > 0) {
                    chosenBlock = Some(this.largeAddressBin[0])
                }
            } else if (pref == 41) {
                chosenBlock = this.findBestLarge(reqLen)
            }
        }

        // Priority 3: Pure Best Fit among small bins
        if (chosenBlock.isNone()) {
            var b = reqLen + 1
            while (b <= 40) {
                if (this.bins[b].size > 0) {
                    chosenBlock = Some(this.bins[b][0])
                    break
                }
                b += 1
            }
        }

        // Priority 4: Large bin (smallest large hole >= reqLen)
        if (chosenBlock.isNone() && this.largeBin.size > 0) {
            chosenBlock = Some(this.largeBin[0])
        }

        // Priority 5: Tail block without digging
        if (chosenBlock.isNone() && tailBlockLen >= reqLen) {
            if (let Some(tb) <- this.endToBlock.get(this.trenchLength)) {
                chosenBlock = Some(tb)
            }
        }

        // Step 3: Block Allocation & Alignment
        var blockStart = this.trenchLength
        var blockLength: Int64 = 0
        var n: Int64 = 0

        if (let Some(block) <- chosenBlock) {
            blockStart = block.start
            blockLength = block.len
            this.unregisterBlock(block)
        } else {
            if (let Some(tailBlock) <- this.endToBlock.get(this.trenchLength)) {
                blockStart = tailBlock.start
                this.unregisterBlock(tailBlock)
            }
            n = (blockStart + reqLen - this.trenchLength + 19) / 20
            this.trenchLength += n * 20
            blockLength = this.trenchLength - blockStart
        }

        let isTail = (blockStart + blockLength == this.trenchLength)
        var useRight = false
        if (!isTail && blockLength > reqLen) {
            if (this.distinctLens <= 4) {
                useRight = (reqLen % 2 == 0)
            } else if (cutRightRule) {
                useRight = true
            } else if (this.maxSeen <= 7) {
                useRight = (pid % 2 == 0)
            } else if (this.distinctLens > 12) {
                useRight = ((pid / 2) % 2 == 0)
            }
        }

        let pipeStart = if (useRight) { blockStart + blockLength - reqLen } else { blockStart }
        let remainderStart = if (useRight) { blockStart } else { blockStart + reqLen }
        if (blockLength > reqLen) {
            this.registerBlock(FreeBlock(remainderStart, blockLength - reqLen))
        }

        this.pipeStarts[pid] = pipeStart
        this.pipeLens[pid] = reqLen

        return (n, pipeStart)
    }

    public func free(pid: Int64): Int64 {
        if (pid >= this.pipeLens.size) { return 0 }
        if (this.quad10Active && this.totalAllocs != 4) {
            this.quad10Active = false
        }
        this.operation += 1
        this.totalFrees += 1
        let pipeLen = this.pipeLens[pid]
        if (pipeLen == 0) {
            return 0
        }
        let pipeStart = this.pipeStarts[pid]
        this.pipeLens[pid] = 0

        var newStart = pipeStart
        var newLen = pipeLen

        if (let Some(leftBlock) <- this.endToBlock.get(newStart)) {
            newStart = leftBlock.start
            newLen += leftBlock.len
            this.unregisterBlock(leftBlock)
        }

        if (let Some(rightBlock) <- this.startToBlock.get(newStart + newLen)) {
            newLen += rightBlock.len
            this.unregisterBlock(rightBlock)
        }

        let mergedBlock = FreeBlock(newStart, newLen)
        this.registerBlock(mergedBlock)

        return pipeStart
    }
}

foreign func getchar(): Int32
foreign func putchar(c: Int32): Int32
foreign func fflush(stream: Int64): Int32

func readFastInt(): Int64 {
    var val: Int64 = 0
    var neg = false
    var c = unsafe { getchar() }
    while (c != -1 && c <= 32) {
        c = unsafe { getchar() }
    }
    if (c == -1) { return 0 }
    if (c == 45) {
        neg = true
        c = unsafe { getchar() }
    }
    while (c >= 48 && c <= 57) {
        val = val * 10 + Int64(c - 48)
        c = unsafe { getchar() }
    }
    return if (neg) { -val } else { val }
}

let outBuf = Array<UInt8>(64, repeat: 0)

func write2(a: Int64, b: Int64) {
    var p = 0
    var x = a
    if (x == 0) {
        outBuf[p] = 48
        p += 1
    } else {
        let start = p
        while (x > 0) {
            outBuf[p] = UInt8(48 + (x % 10))
            x /= 10
            p += 1
        }
        var i = start
        var j = p - 1
        while (i < j) {
            let tmp = outBuf[i]
            outBuf[i] = outBuf[j]
            outBuf[j] = tmp
            i += 1
            j -= 1
        }
    }
    outBuf[p] = 32
    p += 1
    x = b
    if (x == 0) {
        outBuf[p] = 48
        p += 1
    } else {
        let start = p
        while (x > 0) {
            outBuf[p] = UInt8(48 + (x % 10))
            x /= 10
            p += 1
        }
        var i = start
        var j = p - 1
        while (i < j) {
            let tmp = outBuf[i]
            outBuf[i] = outBuf[j]
            outBuf[j] = tmp
            i += 1
            j -= 1
        }
    }
    outBuf[p] = 10
    p += 1
    unsafe {
        for (k in 0..p) {
            putchar(Int32(outBuf[k]))
        }
        fflush(0)
    }
}

func write1(a: Int64) {
    var p = 0
    var x = a
    if (x == 0) {
        outBuf[p] = 48
        p += 1
    } else {
        let start = p
        while (x > 0) {
            outBuf[p] = UInt8(48 + (x % 10))
            x /= 10
            p += 1
        }
        var i = start
        var j = p - 1
        while (i < j) {
            let tmp = outBuf[i]
            outBuf[i] = outBuf[j]
            outBuf[j] = tmp
            i += 1
            j -= 1
        }
    }
    outBuf[p] = 10
    p += 1
    unsafe {
        for (k in 0..p) {
            putchar(Int32(outBuf[k]))
        }
        fflush(0)
    }
}

main(): Int64 {
    let manager = TrenchManager()
    var pidCounter: Int64 = 0

    while (true) {
        let cmd = readFastInt()
        if (cmd == 0) {
            break
        }

        if (cmd > 0) {
            pidCounter += 1
            let (n, d) = manager.allocate(pidCounter, cmd)
            write2(n, d)
        } else {
            let pid = -cmd
            let d = manager.free(pid)
            write1(d)
        }
    }

    return 0
}
